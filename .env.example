# Planetary Computer works anonymously for public collections.
# Optional: set a subscription key for higher rate limits.
PC_SDK_SUBSCRIPTION_KEY=

# Copernicus Data Space (only needed if pulling S3 OLCI directly from CDSE
# instead of Planetary Computer). Never commit real values.
CDSE_USERNAME=
CDSE_PASSWORD=

# Copernicus Marine (ocean currents for the forecast module)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# API
BLUEBAN_API_HOST=127.0.0.1
BLUEBAN_API_PORT=8813
# Optional: the API POSTs each new alert (JSON) here; delivery is up to the receiver.
BLUEBAN_ALERT_WEBHOOK=
# Optional: another database (default sqlite:///data/blueban.sqlite)
DATABASE_URL=
